# 复制为每个 stack 目录下的 .env 后填写；不要提交真实值
# cp .env.example .env && chmod 600 .env

TZ=Asia/Shanghai

# ── 公共
PUID=1026
PGID=100

# ── snipe-it
MYSQL_DATABASE=snipeit
MYSQL_USER=snipeit
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
APP_KEY=base64:REPLACE_WITH_openssl_rand_-base64_32

# ── wavelog
WAVELOG_DB_HOST=db
WAVELOG_DB_NAME=wavelog
WAVELOG_DB_USER=wavelog
WAVELOG_DB_PASSWORD=change-me

# ── 通知 webhook（飞书/钉钉/企业微信任选，留空则只写日志）
ALERT_WEBHOOK=

# ── 反向代理上游（示例网段）
NAS_BRIDGE_IP=192.168.1.6
